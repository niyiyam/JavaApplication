<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/house_bg"
    android:orientation="vertical"
    tools:context=".MangoHouseFragment">

    <!-- 지붕 모양 헤더: 지붕 그림 위 나무판에 제목 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-14dp"
            android:layout_marginEnd="-14dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/house_roof" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="30dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/house_title"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/house_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#F2E3D2"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 지붕 아래 벽: 나무 틀 벽 그림 위에 망고 칸 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/house_wall" />

    <!-- 스크롤 영역을 나무 틀 안쪽으로 한정: 카드가 틀 밑으로 들어가며 잘린다 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="18dp"
        android:fadingEdgeLength="16dp"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingTop="10dp"
            android:paddingEnd="4dp"
            android:paddingBottom="10dp">

            <!-- 보관된 망고 그리드, 보관 순서대로 (코드에서 채움) -->
            <GridLayout
                android:id="@+id/house_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3" />

            <TextView
                android:id="@+id/house_empty"
                style="@style/SubText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/house_empty" />
        </LinearLayout>
    </ScrollView>
    </FrameLayout>
</LinearLayout>
