<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg"
    android:orientation="vertical">

    <include layout="@layout/view_top_bar" />

    <!-- 프래그먼트가 들어갈 자리 -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 사진 위쪽의 연한 베이지 경계선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EFE6D2" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFDF7"
        app:menu="@menu/bottom_nav_menu"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:itemTextAppearanceActive="@style/BottomNavActiveText"
        app:labelVisibilityMode="labeled"
        app:itemActiveIndicatorStyle="@null"
        app:elevation="0dp"
        app:itemIconSize="40dp"
        app:activeIndicatorLabelPadding="0dp"/>
</LinearLayout>
