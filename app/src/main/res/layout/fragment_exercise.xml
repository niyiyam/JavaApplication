<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 오늘의 운동 통계 -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/exercise_title" />

                <TextView
                    android:id="@+id/exercise_zone"
                    style="@style/SubText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <include
                layout="@layout/view_day_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tile_score"
                    layout="@layout/view_stat_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/tile_minutes"
                    layout="@layout/view_stat_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tile_leaves"
                    layout="@layout/view_stat_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/tile_exp"
                    layout="@layout/view_stat_tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- 오늘 운동 기록 목록 (코드에서 채움) -->
            <LinearLayout
                android:id="@+id/exercise_today_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/exercise_today_empty"
                style="@style/SubText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="8dp"
                android:text="@string/today_empty" />
        </LinearLayout>

        <!-- [임시] 운동 기록 입력: 최종에는 시작 버튼 + 타이머로 바뀐다 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_temp_card"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/add_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_temp"
                    android:text="@string/add_temp_chip"
                    android:textColor="@color/temp_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 운동 종류 7개 (코드에서 채움) -->
            <GridLayout
                android:id="@+id/exercise_type_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="4" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SubText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/add_time"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/exercise_minus"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_stepper_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/minus"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />

                <EditText
                    android:id="@+id/exercise_minutes"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="end|center_vertical"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:hint="@string/add_time" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="12dp"
                    android:text="@string/minutes_unit"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/exercise_plus"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_stepper_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/plus"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- 지금 구간 기준으로 계산한 실제 보상 미리보기 -->
            <TextView
                android:id="@+id/exercise_preview"
                style="@style/BodyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_tile"
                android:padding="14dp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/exercise_add"
                style="@style/PrimaryButton"
                android:layout_marginTop="16dp"
                android:text="@string/add_button" />

            <!-- [임시] 오늘 기록 초기화 (테스트용) -->
            <TextView
                android:id="@+id/exercise_temp_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:text="@string/temp_reset"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- [임시] 더미 데이터 불러오기 (발표 시연용) -->
        <TextView
            android:id="@+id/exercise_temp_dummy"
            style="@style/TempButton"
            android:text="@string/temp_dummy" />
    </LinearLayout>
</ScrollView>
