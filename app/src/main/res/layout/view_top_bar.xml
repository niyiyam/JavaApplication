<?xml version="1.0" encoding="utf-8"?>
<!-- 상단 바: 유저 아이콘, 이름/레벨/경험치 바, 이파리 보유량 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/top_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/forest_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- 누르면 프로필 (이름, 체중, 프로필 사진) -->
    <LinearLayout
        android:id="@+id/top_bar_user"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/profile_open"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.mangofit.app.view.AvatarView
            android:id="@+id/top_bar_avatar"
            android:layout_width="52dp"
            android:layout_height="52dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/top_bar_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/top_bar_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_on_dark_sub"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/top_bar_exp"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="130dp"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:max="1000"
                android:progressDrawable="@drawable/progress_exp_dark" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/top_bar_leaves"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/leaves"
            android:src="@drawable/ic_leaf" />

        <TextView
            android:id="@+id/top_bar_leaves_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
